{
  "name": "svg-icon-starter",
  "private": true,
  "version": "0.0.1-beta.0",
  "scripts": {
    "build" : "npm run clean && npm run build:library",
    "build:library": "npm run transform-icons && npm run copy-library-assets",
    "clean" : "npx rimraf ./dist && npx rimraf ./svg-icons/build && npx rimraf ./svg-icons/indes.ts",
    "copy-library-assets": "cpx README.md dist && cpx package.json dist",
    "pack" : "cd dist/ && npm pack && cd ..",
    "transform-icons": "svg-to-ts-files",
    "clean-package" : "node clean-package.js"
  },
  "devDependencies": {
    "@mdi/svg": "^4.9.95",
    "@deboxsoft/cpx": "^1.5.0",
    "svg-to-ts": "^12.0.0",
    "@nationalbankbelgium/code-style": "^1.11.0",
    "rimraf": "^6.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreuzerk/svg-icon-library-starter.git"
  },
  "keywords": [
    "SVG",
    "icons",
    "library",
    "mdi"
  ],
  "author": "Kevin Kreuzer",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kreuzerk/svg-icon-library-starter/issues"
  },
  "homepage": "https://github.com/kreuzerk/svg-icon-library-starter#readme"
}
